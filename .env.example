# Ports are published by docker-compose.yml on 127.0.0.1 only.
FIXJURY_DATABASE_URL=postgresql+asyncpg://fixjury:fixjury@127.0.0.1:55432/fixjury
FIXJURY_REDIS_URL=redis://127.0.0.1:16379/0
FIXJURY_LOG_LEVEL=INFO

# Corpus tooling: a token raises the GitHub limit from 60 to 5000 requests per hour.
FIXJURY_GITHUB_TOKEN=

# Spec drafts go through the OpenAI-compatible opencode-go endpoint.
FIXJURY_LLM_BASE_URL=https://opencode.ai/zen/go/v1
FIXJURY_LLM_MODEL=
FIXJURY_LLM_API_KEY=
# Zen Go rejects requests without this header value; leave empty only for other providers.
FIXJURY_LLM_SESSION=

# Sandboxes. One container per run, no network unless the run is a container harness.
FIXJURY_SANDBOX_IMAGE=python:3.12-slim
FIXJURY_SANDBOX_CPU=2
FIXJURY_SANDBOX_MEMORY_MB=2048
FIXJURY_SANDBOX_TIMEOUT_S=1200

# Third-party harnesses (PLAN 4.1/4.2). The adapter refuses to run while the image
# is empty: a tag nobody chose is worse than a run that says it is not configured.
# Pin a digest, not just a tag, and put the same version in the *_VERSION field so
# runs recorded under different harness versions are never compared silently.
#
# mini-swe-agent: build dockerfiles/mini/Dockerfile, whose install line and version
# below have to agree. The command is optional; without it the adapter runs
# `mini -c mini.yaml -c fixjury-mini.yaml -t "$(cat TASK.md)"`.
FIXJURY_MINI_IMAGE=
FIXJURY_MINI_COMMAND=
FIXJURY_MINI_VERSION=

FIXJURY_OPENHANDS_IMAGE=
FIXJURY_OPENHANDS_COMMAND=
FIXJURY_OPENHANDS_VERSION=

# Cost. Prices live in the file, not the environment, so the pricing_version that
# produced a number travels with it. The shipped file is explicitly unpriced.
FIXJURY_PRICING_FILE=config/pricing.yaml
# Set to 1 to print OpenTelemetry spans to the console instead of dropping them.
FIXJURY_OTEL_CONSOLE=0
