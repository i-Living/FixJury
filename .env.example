# Ports are published by docker-compose.yml on 127.0.0.1 only.
FIXJURY_DATABASE_URL=postgresql+asyncpg://fixjury:fixjury@127.0.0.1:55432/fixjury
FIXJURY_REDIS_URL=redis://127.0.0.1:16379/0
FIXJURY_LOG_LEVEL=INFO

# Corpus tooling: a token raises the GitHub limit from 60 to 5000 requests per hour.
FIXJURY_GITHUB_TOKEN=

# Spec drafts go through the OpenAI-compatible opencode-go endpoint.
FIXJURY_LLM_BASE_URL=https://opencode.ai/zen/go/v1
FIXJURY_LLM_MODEL=
FIXJURY_LLM_API_KEY=
# Zen Go rejects requests without this header value; leave empty only for other providers.
FIXJURY_LLM_SESSION=
